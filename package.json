{
  "name": "aba-assist",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Free, offline-first reference and study app for people working in Applied Behavior Analysis.",
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "npm run build:packages && vite build",
    "preview": "vite preview",
    "prepare": "npm run build:packages && npm run content:build && svelte-kit sync",
    "content": "tsx packages/content-build/src/cli.ts",
    "content:check": "tsx packages/content-build/src/cli.ts check --channel=pr",
    "content:apply-review": "tsx packages/content-build/src/cli.ts apply-review",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "test": "npm run content:build && vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "content:build": "tsx packages/content-build/src/cli.ts build --channel=${ABA_CONTENT_CHANNEL:-dev}",
    "build:packages": "npm run build -w @aba/content-schema && npm run build -w @aba/content-build",
    "test:perf": "lhci autorun",
    "content:verify": "node scripts/verify-against-sources.mjs",
    "content:balance": "node scripts/balance-question-options.mjs",
    "content:balance:check": "node scripts/balance-question-options.mjs --check"
  },
  "devDependencies": {
    "@aba/content-build": "*",
    "@aba/content-schema": "*",
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.63.0",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@vite-pwa/sveltekit": "^1.1.0",
    "axe-core": "^4.13.0",
    "eslint": "^10.10.0",
    "eslint-plugin-svelte": "^3.23.0",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "tsx": "^4.23.13",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "idb": "^8.0.3",
    "minisearch": "^7.2.0",
    "ts-fsrs": "^5.4.2"
  }
}
